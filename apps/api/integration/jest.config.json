{
  "rootDir": "..",
  "testMatch": ["<rootDir>/integration/**/*.int-spec.ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/integration/tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/integration/setup-env.ts"],
  "testEnvironment": "node",
  "testTimeout": 30000
}
