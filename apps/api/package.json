{
  "name": "@foodstack/api",
  "version": "0.0.0",
  "private": true,
  "description": "FoodStack REST + realtime API (NestJS modular monolith)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:create": "typeorm migration:create",
    "migration:generate": "nest build && typeorm migration:generate -d dist/database/data-source.js",
    "migration:run": "nest build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "nest build && typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "nest build && typeorm migration:show -d dist/database/data-source.js",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.2",
    "bullmq": "6.5.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@foodstack/config": "workspace:*",
    "@foodstack/eslint-config": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!database/migrations/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
