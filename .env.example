# =============================================================================
# FoodStack environment template. Copy to `.env` (git-ignored) and fill in.
# Never commit real secrets. In AWS, values come from Secrets Manager / SSM.
# Validated at API startup by apps/api/src/config/env.validation.ts.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
# API HTTP port
PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Admin dashboard URL (used in links/emails)
APP_URL=http://localhost:3000
# Comma-separated allowed browser origins. Required (no wildcard) in production.
CORS_ORIGINS=http://localhost:3000
# Serve OpenAPI docs at /api/docs (rejected in production)
SWAGGER_ENABLED=true
# Set true behind a load balancer (ALB) so client IPs are read correctly
TRUST_PROXY=false

# --- Frontend (public, inlined at build time; no secrets) --------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_ENV=development

# --- PostgreSQL 18 -----------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Role the API connects as: read/write rows only, no superuser, no BYPASSRLS, so row-level
# security (tenant isolation) applies. Created by infrastructure/docker/postgres/init locally.
DATABASE_USER=foodstack_app
DATABASE_PASSWORD=change-me-local-only
# Schema owner that runs migrations (locally also the container superuser). Must differ from
# DATABASE_USER. In AWS: a dedicated owner role, never the RDS master user for the API.
DATABASE_MIGRATION_USER=foodstack_migrator
DATABASE_MIGRATION_PASSWORD=change-me-local-only-migrator
DATABASE_NAME=foodstack
# true in AWS RDS (TLS with certificate verification)
DATABASE_SSL=false
# CA bundle used to verify the server certificate, e.g. the RDS global bundle
# (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem). Empty = system CAs.
DATABASE_SSL_CA_PATH=
# Connections per API instance (sum across instances must stay below RDS/RDS Proxy limits)
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOGGING=false

# --- Redis (cache, BullMQ queues, Socket.IO adapter) -------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-only
REDIS_TLS=false
QUEUE_PREFIX=foodstack

# --- Email worker (pnpm --filter @foodstack/api dev:worker; container: worker) ----
# Business code only queues email (transactional outbox); the worker delivers it.
EMAIL_WORKER_CONCURRENCY=5
EMAIL_SEND_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=5
OUTBOX_RECOVERY_INTERVAL_SECONDS=30
OUTBOX_STALE_SECONDS=60
OUTBOX_SENT_RETENTION_DAYS=7
OUTBOX_FAILED_RETENTION_DAYS=30
WORKER_HEARTBEAT_FILE=/tmp/foodstack-worker.alive

# --- Rate limiting (per client IP, shared across instances via Redis) --------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Auth --------------------------------------------------------------------
# Access tokens are signed with EdDSA (Ed25519). Required in staging/production; optional locally
# until the auth module lands. Values are PEM (raw, \n-escaped or base64-encoded).
# Generate a pair:  pnpm --filter @foodstack/api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=local
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_ABSOLUTE_TTL=90d
JWT_ISSUER=foodstack-api
# Unset = host-only cookies. In AWS: the shared parent domain (e.g. .foodstack.app).
COOKIE_DOMAIN=
# Must be true outside local development (cookies sent over HTTPS only)
COOKIE_SECURE=false
# AES-256-GCM key (32 bytes, base64) encrypting TOTP secrets and queued email (outbox). This value is for local development
# only and is rejected in staging/production: generate a real one with keys:generate.
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS1kby1ub3QtdXNlLTMyYiE=
MFA_ISSUER=FoodStack

# --- Email (local: Mailpit catches everything, UI on http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=FoodStack <no-reply@foodstack.local>

# Subscription payments are verified manually by a Super Admin; owners see these instructions.
BILLING_PAYMENT_INSTRUCTIONS=
# Razorpay online subscription payments (leave empty to use manual verification only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Background expiry sweep interval in seconds (0 disables; requests are always checked)
SUBSCRIPTION_SWEEP_INTERVAL_SECONDS=300

# --- AWS (placeholders) ------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Locally prefer `aws sso login` / profiles; never commit access keys.
